# Telegram
TELEGRAM_BOT_TOKEN=            # від @BotFather
TELEGRAM_WEBHOOK_SECRET=       # будь-який випадковий рядок (захист вебхука)
ALLOWED_USER_IDS=              # Telegram ID менеджерів через кому; порожньо = доступ усім
WEBAPP_URL=                    # https://<ваш-домен>/ (необов'язково, інакше береться з запиту)

# KeyCRM
KEYCRM_API_KEY=                # Налаштування → API в KeyCRM
KEYCRM_SOURCE_ID=              # ID джерела замовлення (npm run keycrm:sources)
KEYCRM_MANAGER_MAP=            # telegramId:keycrmManagerId через кому, напр. 123456:5,789012:7
KEYCRM_DOMAIN=                 # напр. waterhub.keycrm.app — для посилань на замовлення

# Тільки для self-hosting (server.js)
PORT=3000
